# Copy to .env to override defaults (all optional).
TRAFFIC_DEVICE=cuda:0           # or cpu
TRAFFIC_HALF=true               # FP16 inference on GPU
TRAFFIC_DETECT_CONF=0.3
TRAFFIC_PLATE_CONF=0.35
TRAFFIC_REALTIME=true           # pace video files at their native FPS
TRAFFIC_AUTOSTART=true          # start all cameras in cameras.json with the API
TRAFFIC_CORS_ORIGINS=http://localhost:3400,http://127.0.0.1:3400
# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8400
